{
  "name": "large_file_previews",
  "description": "Large File Previews: previews of files too large for Nextcloud's own providers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode development build --watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src --fix",
    "stylelint": "stylelint src/**/*.vue src/**/*.css",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.8.2",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^8.4.2",
    "@nextcloud/stylelint-config": "^3.1.0",
    "@nextcloud/vite-config": "^2.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "15.20.0",
    "happy-dom": "^20.0.10",
    "typescript": "^5.9.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.1",
    "vue-tsc": "^3.3.11"
  }
}
