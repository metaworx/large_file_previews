# What is this app's own in the vendored install-check.yml, read by its
# first step as shell assignments; each left unset leaves its step out.

# What the preview check renders with, and what the settings page's tests
# need to change a type; timeout, prlimit and choom are coreutils and
# util-linux, already on the runner.
APT_PACKAGES="poppler-utils libvips-tools libtiff-tools"

# The browser tests run against the installed copy.
SMOKE_SPECS="tests/e2e/settings.cy.js,tests/e2e/l10n-german.cy.js"

# The server configured for them.
E2E=true
