/.env.local
/.env.*.local
/.env.secrets
/.env.*.secrets
/.local/

*.phar
.phpunit.result.cache

/vendor
/vendor-bin/*/vendor/
# Strauss's phar (composer vendor:scope). composer install ends in
# `composer bin all install`, which takes the directory for a namespace of
# its own and writes a composer.json, a lock and a vendor/ beside the phar.
/vendor-bin/strauss/
# The guidelines root ignores its own runtime directories; these entries are
# kept so a checkout without the submodule still ignores them.
/GUIDELINES/messages/
/GUIDELINES/temp/
/GUIDELINES/config.local.ini
/tests/.phpunit.cache
/.phpunit.cache/

# Nextcloud source trees beside the checkout, for the IDE and the test
# bootstrap's fallback.
/nextcloud-v*/

/node_modules/
/js/
/css/

# Cypress's own output: failure screenshots and downloads.
/cypress/

/build/
